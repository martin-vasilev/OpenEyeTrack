{
  "name": "openeyetrack",
  "version": "0.3.0",
  "private": true,
  "description": "Browser-native webcam eye tracking for behavioural research",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:sdk": "vite build --config vite.config.sdk.ts && tsc -p tsconfig.sdk.json",
    "test:sdk": "npm run build:sdk && node scripts/sdk-smoke.mjs",
    "build:all": "npm run build && npm run build:sdk",
    "package:sdk": "npm run build:sdk && node scripts/package-sdk.mjs",
    "verify:sdk-package": "node scripts/verify-sdk-package.mjs",
    "pack:sdk": "npm run package:sdk && npm run verify:sdk-package && node scripts/pack-sdk.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "onnxruntime-web": "^1.22.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "module": "./dist-sdk/openeyetrack.es.js",
  "types": "./dist-sdk/types/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-sdk/types/sdk/index.d.ts",
      "import": "./dist-sdk/openeyetrack.es.js"
    }
  },
  "files": [
    "dist-sdk",
    "README.md",
    "LICENSE"
  ]
}
